# ---------------------------------------------------------------------------
# Copy to secrets/api-keys.env and fill in your keys.
# ---------------------------------------------------------------------------

# One key per LLM provider. To leave out a provider you have no key for, set
# "enabled": false on it in providers.json.
ANTHROPIC_API_KEY=sk-ant-...
MISTRAL_API_KEY=...
GEMINI_API_KEY=...

# The key of the embeddings provider set in demo.env (Mistral by default), for
# the semantic cards (caching, routing, prompt and topic guards). With Mistral,
# it can be the same key as MISTRAL_API_KEY.
EMBEDDINGS_PROVIDER_API_KEY=...

# The key of Intelligent routing's classifier set in demo.env. Left blank,
# MISTRAL_API_KEY is used (the default classifier is Mistral's).
CLASSIFIER_API_KEY=

# Moesif analytics, when demo.env's ANALYTICS_MODE is "moesif": your Moesif
# Application ID (in Moesif: Settings, API Keys). Left blank, analytics stay off.
APIP_GW_ANALYTICS_PUBLISHERS_MOESIF_APPLICATION_ID=
