# ---------------------------------------------------------------------------
# Copy to secrets/api-keys.env and fill in your keys.
# ---------------------------------------------------------------------------

# One key per LLM provider. To leave a provider out, list it in
# DISABLED_PROVIDERS in demo.env (Gemini is, by default).
ANTHROPIC_API_KEY=sk-ant-...
MISTRAL_API_KEY=...
GEMINI_API_KEY=...

# The keys of the embeddings model (semantic cards) and of Intelligent
# routing's classifier, when demo.env sets them to a provider other than
# Mistral. Left blank, MISTRAL_API_KEY is used.
EMBEDDINGS_PROVIDER_API_KEY=
CLASSIFIER_API_KEY=

# Moesif analytics, when demo.env's ANALYTICS_MODE is "moesif": your Moesif
# Application ID (in Moesif: Settings, API Keys). Left blank, analytics stay off.
APIP_GW_ANALYTICS_PUBLISHERS_MOESIF_APPLICATION_ID=
