# ---------------------------------------------------------------------------
# Template for demo.env, the demo's settings: its name, hostname, versions and
# ports. The scripts copy it to demo.env on the first run. To suit a machine,
# change demo.env, not this file: git ignores demo.env, so changes stay local.
# Started by hand with `docker compose up`, without the scripts, each compose
# file falls back to its own defaults instead.
# ---------------------------------------------------------------------------

# Lowercase/hyphens only -- used as the custom gateway image prefix.
DEMO_NAME=ai-demo

# The hosted VM's public hostname. Blank locally: each use falls back to its
# own default (localhost for the gateway's MCP 401s).
DEMO_HOSTNAME=

# Image/distro versions. ai-gateway/build.yaml's own gateway.version is a
# separate value (read by the `ap` CLI, not Compose) -- bump both by hand,
# see TECH_DEBT.md.
PLATFORM_API_VERSION=0.16.0
AI_WORKSPACE_VERSION=1.0.0
API_PORTAL_VERSION=1.0.0
AI_GATEWAY_VERSION=1.2.0

# Component ports -- identical locally and on the VM.
AI_CHATBOT_PORT=8600
PLATFORM_API_PORT=9243
AI_WORKSPACE_PORT=9643
API_PORTAL_PORT=9543

# Moves all the gateway's ports up by this number, like the port offset of WSO2
# products: with 1, 8443 becomes 8444 and 9090 becomes 9091. Use it on a
# machine where another program already uses the gateway's ports.
GATEWAY_PORT_OFFSET=0

# "moesif" (real analytics, needs an id in secrets/api-keys.env) or "local"
# (the Jaeger/OpenSearch/Prometheus stack). Never both. No inline comment on
# the line below -- this file is also read as a raw container env_file,
# which doesn't strip trailing "# ...".
ANALYTICS_MODE=moesif

# The A2A Gateway page (beta): the assistant hands questions to another agent.
# true starts a second gateway for it, the same as the main one on a version
# with A2A, its ports one above (see a2a/). The main gateway is not touched.
# Takes effect with ./scripts/run-local.sh.
A2A_ENABLED=false

# Peak hours of the "Time-based routing" card, and their time zone.
PEAK_HOURS=13:30-18:00
PEAK_TIMEZONE=Europe/Paris

# How budgets and rate limits count (fixed-window when unset):
#   gcra          capacity comes back gradually; the cards are tuned for it
#   fixed-window  the count resets at fixed times of the clock
# The demo uses gcra. In production, weigh the choice against performance
# and memory use. With several gateways, a shared Redis backend is
# recommended (config.toml), with the same value on every gateway.
RATE_LIMIT_ALGORITHM=gcra

# The embeddings model of the semantic cards (caching, semantic routing,
# prompt and topic guards). Keep one block uncommented. For a provider other
# than Mistral, put its key in EMBEDDINGS_PROVIDER_API_KEY, in
# secrets/api-keys.env. The cards' similarity thresholds are tuned for
# Mistral's model. Anthropic has no embeddings model.
# Gemini, paid key only (the free quota refuses the gateway's startup calls):
# EMBEDDING_PROVIDER=OPENAI
# EMBEDDING_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/embeddings
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=3072
# Mistral (Used for this demo):
EMBEDDING_PROVIDER=MISTRAL
EMBEDDING_ENDPOINT=https://api.mistral.ai/v1/embeddings
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSION=1024

# The model that reads each question and picks the rule in Intelligent
# routing. Keep one block uncommented. For a provider other than Mistral, put
# its key in CLASSIFIER_API_KEY, in secrets/api-keys.env. When this model
# fails (wrong key, no quota left), every question takes the backup route.
# Anthropic:
# CLASSIFIER_PROVIDER=OPENAI
# CLASSIFIER_ENDPOINT=https://api.anthropic.com/v1/chat/completions
# CLASSIFIER_MODEL=claude-haiku-4-5
# Gemini, paid key recommended (the free tier allows 20 questions a day):
# CLASSIFIER_PROVIDER=OPENAI
# CLASSIFIER_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# CLASSIFIER_MODEL=gemini-2.5-flash
# Mistral (Used for this demo):
CLASSIFIER_PROVIDER=OPENAI
CLASSIFIER_ENDPOINT=https://api.mistral.ai/v1/chat/completions
CLASSIFIER_MODEL=ministral-14b-latest


# Cards to show greyed out and not clickable, by id (from
# ai-chatbot/showcases.json), comma-separated -- for one whose outside service
# is down during a live demo. Takes effect on the next page load.
# DISABLED_CARDS=content-safety-bedrock

# Rows of cards to hide from the home screen, by id (the "groups" list of
# ai-chatbot/showcases.json), comma-separated. For example the EU AI Act row,
# when the audience is outside Europe. A card that is also in another row stays
# there. Takes effect on the next page load.
# DISABLED_GROUPS=compliance-eu-ai-act

# To use an AI Workspace and a gateway that already run elsewhere (see the
# README), uncomment and fill in the first three. Export the admin password
# (REMOTE_ADMIN_PASSWORD), never write it here.
# REMOTE_AI_WORKSPACE_URL=https://workspace.example.com:9643
# REMOTE_GATEWAY_ID=their-gateway-id
# REMOTE_GATEWAY_URL=https://gateway.example.com:8443
# Optional:
# REMOTE_ADMIN_USERNAME=admin
# REMOTE_PROJECT_ID=ai-demo
# REMOTE_GATEWAY_CONTROLLER_URL=http://gateway.example.com:9090

# To send the MCP cards to another gateway, already registered in AI
# Workspace. Works with this machine's stack too.
# REMOTE_MCP_GATEWAY_ID=their-mcp-gateway-id
# REMOTE_MCP_GATEWAY_URL=https://mcp-gateway.example.com:8443
# REMOTE_MCP_GATEWAY_CONTROLLER_URL=http://mcp-gateway.example.com:9090
